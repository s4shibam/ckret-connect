    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "google-auth-library": "^9.15.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
